<?xml version='1.0' encoding='cp1252'?>
<robot name="squiggle">

	<link name="link1">
		<collision>
			<origin xyz="-0.5 0 0" rpy = "0 0 0" />
			<geometry>
				<box size = "1 0.1 0.1" />
			</geometry>
		</collision>
	</link>

	<link name="link2">
		<collision>
			<origin xyz="0.5 0 0" rpy = "0 0 0" />
			<geometry>
				<box size = "1 0.1 0.1" />
			</geometry>
		</collision>
	</link>

    <joint name="q1" type="continuous">
        <parent link="link1" />
        <child link="link2" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>

	<link name="link3">
		<collision>
			<origin xyz="0.5 0 0" rpy = "0 0 0" />
			<geometry>
				<box size = "1 0.1 0.1" />
			</geometry>
		</collision>
	</link>

    <joint name="q2" type="continuous">
        <parent link="link2" />
        <child link="link3" />
        <origin xyz="1 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>


</robot>