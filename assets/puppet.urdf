<?xml version='1.0' encoding='cp1252'?>
<robot name="puppet">

    <!--body references and transformations -->
    <link name="upper-torso">
        <collision>
            <origin xyz="0 0 23e-3" rpy="0 0 0" />
            <geometry>
                <sphere radius="32e-3" />
            </geometry>
        </collision>
        <collision>
            <origin xyz="0 0 -10e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="27e-3" length="20e-3" />
            </geometry>
        </collision>
        <collision>
            <origin xyz="0 0 -50e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="40e-3" length="60e-3" />
            </geometry>
        </collision>
    </link>
    <link name="upper-torso-waist-stator">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="networked-encoder/CAD/stl/stator-coarse.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -2.16e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="21e-3" length="20.88e-3" />
            </geometry>
        </collision>
    </link>
    <link name="base">
        <collision>
            <origin xyz="0 0 -90e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="10e-3" length="180e-3" />
            </geometry>
        </collision>
        <collision>
            <origin xyz="0 0 -180e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="180e-3" length="10e-3" />
            </geometry>
        </collision>
    </link>
    <link name="base-rotor-waist">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="networked-encoder/CAD/stl/rotor-coarse.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -6.8e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="13.45e-3" length="17.6e-3" />
            </geometry>
        </collision>
    </link>
    <joint name="upper-torso-to-stator" type="fixed">
        <parent link="upper-torso" />
        <child link="upper-torso-waist-stator" />
        <origin xyz="0 0 -80e-3" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>
    <joint name="upper-torso-stator-to-base-rotor" type="fixed">
        <parent link="upper-torso-waist-stator" />
        <child link="base-rotor-waist" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>
    <joint name="base-rotor-to-base" type="fixed">
        <parent link="base-rotor-waist" />
        <child link="base" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>
    <link name="upper-torso-arm-stator-right">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="networked-encoder/CAD/stl/stator-coarse.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -2.16e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="21e-3" length="20.88e-3" />
            </geometry>
        </collision>
    </link>
    <link name="upper-torso-arm-stator-left">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="networked-encoder/CAD/stl/stator-coarse.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -2.16e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="21e-3" length="20.88e-3" />
            </geometry>
        </collision>
    </link>
    <link name="uppertorso-bone-armstator-left">
    </link>    
    <joint name="uppertorso-bone-left" type="fixed">
        <parent link="upper-torso" />
        <child link="uppertorso-bone-armstator-left" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <joint name="uppertorso-bone-upperarmstator" type="fixed">
        <parent link="uppertorso-bone-armstator-left" />
        <child link="upper-torso-arm-stator-left" />
        <origin xyz="0 40e-3 0" rpy="0 -1.57079633 0" />
    </joint>
    <link name="uppertorso-bone-armstator-right">
    </link>
    <joint name="uppertorso-bone-right" type="fixed">
        <parent link="upper-torso" />
        <child link="uppertorso-bone-armstator-right" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <joint name="uppertorso-bone-upperarmstator" type="fixed">
        <parent link="uppertorso-bone-armstator-right" />
        <child link="upper-torso-arm-stator-right" />
        <origin xyz="0 -40e-3 0" rpy="0 -1.57079633 0" />
    </joint>


    <!-- link 1, including internal fixed transforms -->
    <link name="link1-rotor-left">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="networked-encoder/CAD/stl/rotor-coarse.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -6.8e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="13.45e-3" length="17.6e-3" />
            </geometry>
        </collision>
    </link>
    <link name="link1-bone-left">   
        <!-- add properties - geometry, etc -->
        <collision>
            <origin xyz="0 24e-3 0" rpy="0 0 0" />
            <geometry>
            <sphere radius="5e-3" />
            </geometry>
        </collision>
    </link>
    <link name="link1-stator-left">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="networked-encoder/CAD/stl/stator-coarse.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -2.16e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="21e-3" length="20.88e-3" />
            </geometry>
        </collision>
    </link>
    <joint name="link1-rotor-to-bone-left" type="fixed">
        <parent link="link1-rotor-left" />
        <child link="link1-bone-left" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <joint name="link1-bone-to-stator-left" type="fixed">
        <parent link="link1-bone-left" />
        <child link="link1-stator-left" />
        <origin xyz="0 37.5e-3 0" rpy="1.57079633 0 0" />
    </joint>
    <!-- rotational joint in link 1-->
    <joint name="q1-left" type="continuous">
        <parent link="upper-torso-arm-stator-left" />
        <child link="link1-rotor-left" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>


