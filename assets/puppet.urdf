            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -6.8e-3" rpy="0 0 0" />
            <geometry>
                <cylinder radius="13.45e-3" length="17.6e-3" />
            </geometry>
        </collision>
    </link>
        <link name="link5-wrist-right">
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="13.45e-3" length="60e-3" />
            </geometry>
        </collision>        
    </link>
    <link name="link5-hammer-right">
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="19e-3" length="40e-3" />
            </geometry>
        </collision>        
    </link>
    <joint name="link5-rotor-to-wrist-right" type="fixed">
        <parent link="link5-rotor-right" />
        <child link="link5-wrist-right" />
        <origin xyz="0 0 -45e-3" rpy="0 0 0" />
    </joint>
    <joint name="link5-wrist-to-hammer-right" type="fixed">
        <parent link="link5-wrist-right" />
        <child link="link5-hammer-right" />
        <origin xyz="0 0 -30e-3" rpy="0 1.57 0" />
    </joint>
    <!-- rotational joint q5 -->
    <joint name="q5-right" type="continuous">
        <parent link="link4-stator-right" />
        <child link="link5-rotor-right" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>


















</robot>